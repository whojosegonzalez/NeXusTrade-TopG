# NeXusTrade local config
NEXUSTRADE_MODE=PAPER
NODE_ENV=development

# Provider configuration. DexScreener and Raydium public HTTP endpoints do not require keys.
PROVIDERS_ENABLED=DEXSCREENER,JUPITER,RAYDIUM,SOLANA_RPC,QUICKNODE_DAS
PROVIDER_TIMEOUT_MS=10000
PROVIDER_MAX_RETRIES=2
PROVIDER_RETRY_BACKOFF_MS=250
ENABLE_PROVIDER_RAW_PAYLOAD_LOGGING=false
WRITE_PROVIDER_HEALTH=true

DEXSCREENER_BASE_URL=https://api.dexscreener.com
DEXSCREENER_RATE_LIMIT_PER_MINUTE=300

# Jupiter Price v3 and Swap quote endpoints currently require x-api-key.
JUPITER_PRICE_BASE_URL=https://api.jup.ag/price/v3
JUPITER_SWAP_BASE_URL=https://api.jup.ag/swap/v1
JUPITER_RATE_LIMIT_PER_MINUTE=60
JUPITER_API_KEY=
JUPITER_DEMAND_CONTROLLER_ENABLED=true
JUPITER_DEMAND_WINDOW_MS=60000
JUPITER_DEMAND_MAX_LIVE_REQUESTS_PER_WINDOW=48
JUPITER_DEMAND_BASE_MIN_INTERVAL_MS=1250
JUPITER_DEMAND_MAX_INTERVAL_MS=15000
JUPITER_DEMAND_ADAPTIVE_ENABLED=true
JUPITER_DEMAND_RATE_LIMIT_MULTIPLIER=2
JUPITER_DEMAND_SUCCESS_DECAY_COUNT=4
JUPITER_DEMAND_MAX_LOW_PRIORITY_REQUESTS_PER_WINDOW=12
JUPITER_DEMAND_DEFER_LOW_PRIORITY_FIRST=true
JUPITER_DEMAND_RESPECT_RETRY_AFTER=true

# Phase 9.4D local quote-budget allocation. This selects the bounded risk-cycle cohort before
# a router request. It does not change the shared Jupiter controller safety budget.
QUOTE_BUDGET_PLANNER_ENABLED=true
QUOTE_BUDGET_MAX_CANDIDATES_PER_CYCLE=20
QUOTE_BUDGET_RECENCY_WEIGHT=4
QUOTE_BUDGET_LIQUIDITY_WEIGHT=3
QUOTE_BUDGET_VOLUME_WEIGHT=3
QUOTE_BUDGET_AGE_WEIGHT=2
QUOTE_BUDGET_PRIOR_EVIDENCE_WEIGHT=2

# Raydium quote diagnostics.
RAYDIUM_API_V3_BASE_URL=https://api-v3.raydium.io
RAYDIUM_BASE_URL=https://transaction-v1.raydium.io
RAYDIUM_RATE_LIMIT_PER_MINUTE=60
RAYDIUM_DIAGNOSTICS_ENABLED=true
RAYDIUM_PRECHECK_ENABLED=true
RAYDIUM_PRECHECK_TTL_MS=60000

# Solana RPC authority evidence fallback. Use your QuickNode/Alchemy/Solana endpoint.
SOLANA_RPC_BASE_URL=
SOLANA_RPC_RATE_LIMIT_PER_MINUTE=120
SOLANA_RPC_MINT_ACCOUNT_CACHE_ENABLED=true
SOLANA_RPC_MINT_ACCOUNT_CACHE_TTL_MS=900000
SOLANA_RPC_USE_JSON_PARSED=true
SOLANA_RPC_BASE64_FALLBACK_ENABLED=true

# Optional DAS metadata providers.
QUICKNODE_DAS_BASE_URL=
QUICKNODE_DAS_RATE_LIMIT_PER_MINUTE=60
QUICKNODE_DAS_METADATA_ENABLED=true

ALCHEMY_SOLANA_BASE_URL=
ALCHEMY_DAS_RATE_LIMIT_PER_MINUTE=60
ALCHEMY_DAS_METADATA_ENABLED=true

# Optional Helius comparison. Keep out of long-run defaults unless testing Helius specifically.
HELIUS_RPC_BASE_URL=https://mainnet.helius-rpc.com
HELIUS_RATE_LIMIT_PER_MINUTE=60
HELIUS_API_KEY=

# Phase 9.4 Birdeye selective market-data enrichment. Add BIRDEYE to PROVIDERS_ENABLED only after
# configuring an API key and when you intentionally want to spend Birdeye CUs.
BIRDEYE_API_KEY=
BIRDEYE_BASE_URL=https://public-api.birdeye.so
BIRDEYE_RATE_LIMIT_PER_MINUTE=60
BIRDEYE_PRICE_ENABLED=true
BIRDEYE_TOKEN_OVERVIEW_ENABLED=true
BIRDEYE_MARKET_DATA_ENABLED=false
BIRDEYE_EXIT_LIQUIDITY_ENABLED=false
BIRDEYE_CREDITS_CHECK_ENABLED=true
BIRDEYE_CACHE_ENABLED=true
BIRDEYE_CACHE_TTL_MS=300000
BIRDEYE_MAX_REQUESTS_PER_RUN=60
BIRDEYE_MAX_CU_PER_RUN=1200
BIRDEYE_MAX_CANDIDATES_PER_CYCLE=2
BIRDEYE_MIN_SCORE=50
BIRDEYE_OVERVIEW_FRAMES=1m,5m,15m,30m,1h

# Optional. RugCheck is deferred until its API contract is selected.
RUGCHECK_BASE_URL=https://api.rugcheck.xyz
RUGCHECK_RATE_LIMIT_PER_MINUTE=60
RUGCHECK_API_KEY=
