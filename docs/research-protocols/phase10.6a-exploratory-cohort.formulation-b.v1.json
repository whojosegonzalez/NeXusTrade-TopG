        "type": "FINITE_FLOAT",
        "unit": "PERCENT",
        "windowSeconds": 900,
        "maxAgeSeconds": 60
      },
      "market.momentumAccelerationPct": {
        "type": "FINITE_FLOAT",
        "unit": "PERCENT",
        "derivationFormula": "momentum5mPct - momentum15mPct"
