    "indexingConvention": "0_BASED",
    "indexCalculation": "ceil(0.75 * (n - 1))",
    "evaluationRule": "market.momentumAccelerationPct >= Q3(Discovery)",
    "comparisonGroup": "ALL_OTHER_VALID_DISCOVERY_UNITS_WITH_FINITE_ACCELERATION"
